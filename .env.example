# Hosted DeepSeek API (used when LLM_BASE_URL is unset)
API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Self-hosted OpenAI-compatible endpoint: uncomment and point the app at it.
# LLM_BASE_URL=http://127.0.0.1:8000/v1
# LLM_MODEL=Qwen3-0.6B
# LLM_API_KEY=local
# LLM_CONTEXT_WINDOW=32768
# Self-hosted servers often reject JSON mode, max_completion_tokens and strict tool
# schemas; keep these off unless the engine implements them.
# LLM_JSON_MODE=0
# LLM_MAX_COMPLETION_TOKENS=0
# LLM_STRICT_TOOLS=0
